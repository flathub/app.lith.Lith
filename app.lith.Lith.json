{
    "id": "app.lith.Lith",
    "runtime": "org.kde.Platform",
    "runtime-version": "6.10",
    "sdk": "org.kde.Sdk",
    "command": "Lith",
    "finish-args": [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--share=ipc",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=com.canonical.indicator.application",
        "--talk-name=org.ayatana.indicator.application",
        "--talk-name=org.freedesktop.secrets"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/lib/cmake",
        "/mkspecs",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "qcoro",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_CXX_FLAGS=-fPIC"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/danvratil/qcoro",
                    "tag": "v0.13.0",
                    "commit": "98f23d8d8d67e9e24217d268927faec97c713fb0",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^v([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "libsecret",
            "buildsystem": "meson",
            "config-opts": [
                "-Dvapi=false",
                "-Dgtk_doc=false",
                "-Dbash_completion=disabled",
                "-Dmanpage=false",
                "-Dintrospection=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/GNOME/libsecret",
                    "tag": "0.21.8",
                    "commit": "257547ed7a541fc63400f91578216d3b53721c57",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "qtkeychain",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DBUILD_WITH_QT6=ON",
                "-DUSE_CREDENTIAL_STORE=ON",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DBUILD_TRANSLATIONS=OFF",
                "-DCMAKE_CXX_FLAGS=-fPIC"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/frankosterfeld/qtkeychain",
                    "tag": "0.17.0",
                    "commit": "875f77d9f61bd97fd84cca47ce3bc71186dfbd09",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        },
        {
            "name": "Lith",
            "buildsystem": "cmake-ninja",
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/LithApp/Lith",
                    "tag": "v1.6.18",
                    "commit": "89c5774d9d2e2522f900ff2dbed4cf5788a71458",
                    "x-checker-data": {
                        "is-main-source": true,
                        "type": "git",
                        "tag-pattern": "^v([\\d]+[.][\\d.]*[02468][.][\\d]+)$"
                    }
                }
            ]
        }
    ]
}
